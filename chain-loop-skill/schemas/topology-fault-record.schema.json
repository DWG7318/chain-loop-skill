{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DWG7318/chain-loop-skill/schemas/topology-fault-record.schema.json",
  "title": "CLK Topology Fault Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fault_record_id", "fault_series_id", "record_state", "run_id", "baseline_id",
    "baseline_hash", "level_id", "affected_chain_ids", "source_layer", "fault_class",
    "candidate_refs", "attempt_refs", "evidence_refs", "hypothesis", "supersedes",
    "superseded_by", "healthy_chain_controls", "closure", "route", "escalation_trigger",
    "issued_by", "issued_at"
  ],
  "properties": {
    "fault_record_id": {"type": "string", "minLength": 1},
    "fault_series_id": {"type": "string", "minLength": 1},
    "record_state": {"enum": ["OPEN", "FALSIFIED", "ROUTED", "RESOLVED", "SUPERSEDED"]},
    "run_id": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "level_id": {"type": "string", "minLength": 1},
    "affected_chain_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_layer": {"enum": ["D0", "D1", "D2", "LEVEL", "BARRIER", "D3"]},
    "fault_class": {"enum": ["CHAIN_LOCAL", "CROSS_CHAIN_COMPOSITION", "LEVEL_BARRIER"]},
    "candidate_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chain_id", "go_id", "candidate_digest"],
        "properties": {
          "chain_id": {"type": "string", "minLength": 1},
          "go_id": {"type": "string", "minLength": 1},
          "candidate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "attempt_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["layer", "scope_id", "attempt_id"],
        "properties": {
          "layer": {"enum": ["D0", "D1", "D2", "LEVEL", "BARRIER", "D3"]},
          "scope_id": {"type": "string", "minLength": 1},
          "attempt_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_path", "evidence_hash"],
        "properties": {
          "evidence_path": {"type": "string", "minLength": 1},
          "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["hypothesis_id", "status", "statement", "predicted_observation", "falsifier", "evidence_refs"],
      "properties": {
        "hypothesis_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACTIVE", "FALSIFIED", "CONFIRMED"]},
        "statement": {"type": "string", "minLength": 1},
        "predicted_observation": {"type": "string", "minLength": 1},
        "falsifier": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "supersedes": {"type": ["string", "null"], "minLength": 1},
    "superseded_by": {"type": ["string", "null"], "minLength": 1},
    "healthy_chain_controls": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "chain_id", "level_id", "comparability_proven", "comparability_basis",
          "d2_receipt_id", "d2_receipt_hash", "acceptance_substitute",
          "creates_same_level_dependency"
        ],
        "properties": {
          "chain_id": {"type": "string", "minLength": 1},
          "level_id": {"type": "string", "minLength": 1},
          "comparability_proven": {"const": true},
          "comparability_basis": {"type": "string", "minLength": 1},
          "d2_receipt_id": {"type": "string", "minLength": 1},
          "d2_receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "acceptance_substitute": {"const": false},
          "creates_same_level_dependency": {"const": false}
        }
      }
    },
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": [
        "receipt_catalog", "consumption_edges", "changed_receipt_ids",
        "invalidated_receipt_ids", "preserved_receipt_ids", "reverification",
        "barrier_recalculation_only"
      ],
      "properties": {
        "receipt_catalog": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["receipt_id", "receipt_hash", "layer", "scope_id"],
            "properties": {
              "receipt_id": {"type": "string", "minLength": 1},
              "receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "layer": {"enum": ["D0", "D1", "D2", "LEVEL", "BARRIER", "D3"]},
              "scope_id": {"type": "string", "minLength": 1}
            }
          }
        },
        "consumption_edges": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["consumer_receipt_id", "consumed_receipt_ids"],
            "properties": {
              "consumer_receipt_id": {"type": "string", "minLength": 1},
              "consumed_receipt_ids": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "changed_receipt_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "invalidated_receipt_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "preserved_receipt_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reverification": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["layer", "scope_id"],
            "properties": {
              "layer": {"enum": ["D0", "D1", "D2", "LEVEL", "BARRIER", "D3"]},
              "scope_id": {"type": "string", "minLength": 1}
            }
          }
        },
        "barrier_recalculation_only": {"type": "boolean"}
      }
    },
    "route": {
      "enum": [
        "CELL_REWORK", "GO_REWORK_REQUIRED", "LEVEL_REVERIFICATION",
        "BARRIER_RECALCULATION", "PLAN_DEFECT", "CALABASH_REVIEW_REQUIRED",
        "METHOD_BOUNDARY_EXCEEDED"
      ]
    },
    "escalation_trigger": {
      "type": ["string", "null"],
      "enum": [null, "PLAN_DEFECT", "CALABASH_REVIEW_REQUIRED", "METHOD_BOUNDARY_EXCEEDED"]
    },
    "issued_by": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"fault_class": {"const": "CHAIN_LOCAL"}}},
      "then": {"properties": {"affected_chain_ids": {"maxItems": 1}}}
    },
    {
      "if": {"properties": {"fault_class": {"const": "CROSS_CHAIN_COMPOSITION"}}},
      "then": {"properties": {"affected_chain_ids": {"minItems": 2}}}
    },
    {
      "if": {"properties": {"record_state": {"const": "OPEN"}}},
      "then": {"properties": {"hypothesis": {"properties": {"status": {"const": "ACTIVE"}}}}}
    },
    {
      "if": {"properties": {"record_state": {"const": "FALSIFIED"}}},
      "then": {
        "properties": {
          "hypothesis": {"properties": {"status": {"const": "FALSIFIED"}}},
          "superseded_by": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
