{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DWG7318/chain-loop-skill/schemas/amendment-envelope.schema.json",
  "title": "CLK Amendment Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amendment_id", "amendment_type", "version", "state", "run_id", "target_id",
    "authority_id", "issued_at", "reason", "evidence_refs", "baseline_before_hash",
    "baseline_after_hash", "before", "after", "affected_attempts", "affected_receipts",
    "invalidates", "reverification_requirements", "supersedes", "superseded_by"
  ],
  "properties": {
    "amendment_id": {"type": "string", "minLength": 1},
    "amendment_type": {"enum": ["CHAIN_AMENDMENT", "LEVEL_AMENDMENT", "GO_AMENDMENT"]},
    "version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["PROPOSED", "APPROVED", "APPLIED", "REJECTED", "SUPERSEDED"]},
    "run_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "baseline_before_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_after_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "before": {"type": "object"},
    "after": {"type": "object"},
    "affected_attempts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "affected_receipts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "invalidates": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reverification_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]}
  }
}
