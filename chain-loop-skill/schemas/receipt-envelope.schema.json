{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DWG7318/chain-loop-skill/schemas/receipt-envelope.schema.json",
  "title": "CLK Technical Receipt Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id", "receipt_type", "run_id", "feature_slice_id", "baseline_id",
    "baseline_version", "baseline_hash", "contract_id", "contract_version",
    "contract_hash", "attempt_id", "candidate_digest", "actor_id", "responsibility",
    "verification_context_ref", "environment_fingerprint", "workspace_id",
    "evidence_path", "evidence_hash", "issued_at", "consumed_receipts",
    "invalidates", "supersedes", "result", "failure_reason", "details"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "receipt_type": {"enum": ["D0", "D1", "D2", "LEVEL", "D3"]},
    "run_id": {"type": "string", "minLength": 1},
    "feature_slice_id": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "baseline_version": {"type": "integer", "minimum": 1},
    "baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_version": {"type": "integer", "minimum": 1},
    "contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempt_id": {"type": "string", "minLength": 1},
    "candidate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actor_id": {"type": "string", "minLength": 1},
    "responsibility": {"enum": ["WORKER", "CHECKER", "VERIFICATION"]},
    "verification_context_ref": {"type": "string", "minLength": 1},
    "environment_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workspace_id": {"type": "string", "minLength": 1},
    "evidence_path": {"type": "string", "minLength": 1},
    "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "consumed_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_id", "receipt_hash"],
        "properties": {
          "receipt_id": {"type": "string", "minLength": 1},
          "receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "invalidates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED", "EVIDENCE_GAP", "REWORK_REQUIRED", "DEFINITION_DEFECT"]},
    "failure_reason": {"type": ["string", "null"]},
    "details": {"type": "object"}
  }
}
