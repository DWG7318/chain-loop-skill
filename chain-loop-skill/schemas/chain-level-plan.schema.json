{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DWG7318/chain-loop-skill/schemas/chain-level-plan.schema.json",
  "title": "CLK Chain/Level Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "baseline_id", "baseline_version", "baseline_hash", "state", "chains", "levels"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "baseline_version": {"type": "integer", "minimum": 1},
    "baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"const": "FROZEN"},
    "chains": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain_id", "intent", "go_order"],
        "properties": {
          "chain_id": {"type": "string", "minLength": 1},
          "intent": {"type": "string", "minLength": 1},
          "go_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level_id", "ordinal", "assignments", "barrier_claim", "level_verification_required", "verification_reason"],
        "properties": {
          "level_id": {"type": "string", "minLength": 1},
          "ordinal": {"type": "integer", "minimum": 1},
          "assignments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["chain_id", "go_id", "required"],
              "properties": {
                "chain_id": {"type": "string", "minLength": 1},
                "go_id": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"}
              }
            }
          },
          "barrier_claim": {"type": "string", "minLength": 1},
          "level_verification_required": {"type": "boolean"},
          "verification_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
